# Neon pooled connection string (use the host containing "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string (openssl rand -base64 48)
AUTH_SECRET=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Used only by `npm run db:setup-admin`
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
